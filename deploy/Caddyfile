# Caddy terminates TLS (certificate obtained and renewed automatically) and
# forwards to the Node process, which only ever listens on 127.0.0.1.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

bot.recalfy.com {
	encode zstd gzip

	# Only the paths the app actually serves. Everything else is a probe.
	handle /telegram/webhook {
		reverse_proxy 127.0.0.1:3117
	}

	# GET verifies the subscription (Meta's hub.challenge handshake), POST
	# carries messages. Both live on this one path.
	handle /whatsapp/webhook {
		reverse_proxy 127.0.0.1:3117
	}

	handle /health {
		reverse_proxy 127.0.0.1:3117
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/bot.log
	}
}
