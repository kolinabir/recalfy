[Unit]
Description=Recalfy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/srv/recalfy
EnvironmentFile=/srv/recalfy/.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5

# Hardening — the process needs nothing but its own directory and the network.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/recalfy

[Install]
WantedBy=multi-user.target
