# Self-hosting? You don't need this file — run `npx recalfy` and the setup
# wizard writes one for you. This is the full reference, for doing it by hand
# or for running recalfy.com.

# --- Mode -------------------------------------------------------------------
#   hosted   — recalfy.com: Paddle billing, sign-in on the website, a webhook.
#   selfhost — your own install: no billing, no website needed, long polling.
RECALFY_MODE=selfhost

# Self-host only: your numeric Telegram user id. That account is linked at
# boot and is the only one the bot will talk to. @userinfobot tells you yours.
OWNER_TELEGRAM_ID=

# polling (default when self-hosted) needs no domain or HTTPS.
# webhook (default when hosted) needs PUBLIC_URL and `npm run webhook:set`.
TELEGRAM_MODE=

# Where the website is, if this install has one. Used for the links the bot
# says out loud. Blank means recalfy.com when hosted, and no links at all when
# self-hosted.
WEB_URL=

# --- Telegram -------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
#   openssl rand -hex 32
# Webhook mode only.
TELEGRAM_WEBHOOK_SECRET=

# Access is by linked account, not a static list: someone connects by pressing
# "Connect Telegram" on the site, which sends them here with a one-time token.
# Until that handshake completes the bot ignores them, so there is nothing to
# configure — see src/telegram/link.store.ts.

# Two kill switches, both on unless set to 0/false/off. They cover the newest
# Bot API surface in use here, so they exist to be flipped on the VPS without a
# deploy if Telegram changes its mind about either.
#   STREAMING — show the reply as it is written (sendMessageDraft). Off falls
#               back to the "typing…" indicator.
#   BUTTONS   — Undo under a saved fact, Snooze under a due reminder. Off sends
#               the same messages with no keyboard.
# Note that BUTTONS also needs `callback_query` in the webhook's allowed_updates
# — run `npm run webhook:set` once after deploying, not just the deploy.
TELEGRAM_STREAMING=
TELEGRAM_BUTTONS=

# --- WhatsApp (optional) --------------------------------------------------
# Leave every WHATSAPP_* variable blank to run on Telegram alone. The adapter
# only registers once PHONE_NUMBER_ID and ACCESS_TOKEN are both set.
#
# All of these come from the Meta app dashboard under WhatsApp → API Setup,
# except APP_SECRET, which is under App settings → Basic.

# The id of the number Meta issued, NOT the phone number itself.
WHATSAPP_PHONE_NUMBER_ID=

# The number people message, E.164 digits with no '+' — e.g. 8801712345678.
# Used to build the wa.me connect link on the website.
WHATSAPP_BUSINESS_NUMBER=

# Permanent System User token. The one on the dashboard expires in 24 hours;
# generate the real one under Business settings → Users → System users.
WHATSAPP_ACCESS_TOKEN=

# Any long random string. Typed into the webhook config in the dashboard and
# echoed back during Meta's GET handshake.
#   openssl rand -hex 32
WHATSAPP_VERIFY_TOKEN=

# App secret. Meta signs every webhook body with it (X-Hub-Signature-256);
# without it the signature check fails closed and no message is accepted.
WHATSAPP_APP_SECRET=

# Approved utility template used to reach someone more than 24 hours after
# their last message — reminders and the daily brief. Must exist in WhatsApp
# Manager with exactly one body parameter, or those sends fail.
WHATSAPP_NOTIFY_TEMPLATE=recalfy_notification
WHATSAPP_TEMPLATE_LOCALE=en

# --- Server ---------------------------------------------------------------
# Public HTTPS origin, no trailing slash. Used by `npm run webhook:set`.
#
# Local development: `npm run tunnel` prints an ngrok URL — paste it here and
# re-run `npm run webhook:set`. A free ngrok URL changes on every restart.
# Production: your own domain, fronted by Caddy.
PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app
PORT=3117

# --- MongoDB --------------------------------------------------------------
# Local development: the Docker container from docker-compose.yml.
# Production: an Atlas connection string, with the VPS IP allowlisted under
# Network Access. Nothing else changes — see DESIGN.md §7.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=recalfy

# --- Defaults -------------------------------------------------------------
# IANA zone assigned to a new user until they set their own.
DEFAULT_TIMEZONE=UTC

# --- Model -------------------------------------------------------------------
# Any OpenAI-compatible chat API that supports tool calling.
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-5-mini
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-5-mini
#   Z.ai        LLM_BASE_URL=https://api.z.ai/api/paas/v4   LLM_MODEL=glm-5.2
#   Ollama      LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen3:8b
# ZAPI_KEY / ZAI_BASE_URL / GLM_MODEL are the older names and still work.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Paddle (billing) — hosted only; ignored when self-hosted --------------
# Sandbox key from https://sandbox-vendors.paddle.com/authentication-v2 with
# product.write and price.write. Sandbox keys contain "_sdbx"; npm run
# seed:paddle refuses anything else.
PADDLE_API_KEY=

# --- Plan limits ------------------------------------------------------------
# The price ids that tell Keep and Archive apart, so the bot can apply the
# right limits: the 2,000-fact cap, recurring reminders, quiet hours, and
# Telegram-only on Keep. Copy them from the web app's PADDLE_PRICE_* variables
# — the two halves must name the same prices or they will disagree about what
# somebody bought. `npm run paddle:inspect -- --live` prints them.
#
# Leaving these blank is safe and means "treat everyone as Archive". That is
# the deliberate direction: an unenforced limit is a support ticket, where a
# wrongly-enforced one caps a paying customer's memory and withdraws features
# they are being charged for.
PADDLE_PRICE_KEEP_MONTH=
PADDLE_PRICE_KEEP_YEAR=
PADDLE_PRICE_ARCHIVE_MONTH=
PADDLE_PRICE_ARCHIVE_YEAR=
