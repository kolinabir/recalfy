# --- Telegram -------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string. Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header on every webhook call.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram numeric ids and/or @usernames allowed to talk to
# the bot. The webhook URL is public and the bot username is discoverable —
# without this, strangers write to your memory.
#
# Prefer numeric ids: they are permanent, whereas a username can be released
# and claimed by someone else, who would inherit the access. A username can't
# be resolved to an id until its owner messages the bot, so start with the
# @handle and run `npm run whoami` to swap in the id.
TELEGRAM_ALLOWED_USERS=

# --- Server ---------------------------------------------------------------
# Public HTTPS origin, no trailing slash. Used by `npm run webhook:set`.
#
# Local development: `npm run tunnel` prints an ngrok URL — paste it here and
# re-run `npm run webhook:set`. A free ngrok URL changes on every restart.
# Production: your own domain, fronted by Caddy.
PUBLIC_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app
PORT=3117

# --- MongoDB --------------------------------------------------------------
# Local development: the Docker container from docker-compose.yml.
# Production: an Atlas connection string, with the VPS IP allowlisted under
# Network Access. Nothing else changes — see DESIGN.md §7.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=recalfy

# --- Defaults -------------------------------------------------------------
# IANA zone assigned to a new user until they set their own.
DEFAULT_TIMEZONE=UTC

# --- Model (Z.ai / GLM) ---------------------------------------------------
# API key from https://z.ai/model-api
ZAPI_KEY=

# glm-4.7 is the default: ~$0.60/M in, $0.11/M cached — pennies a month at one
# user. glm-4.7-flash is free but rate-limited too hard to hold a conversation.
GLM_MODEL=glm-4.7
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
