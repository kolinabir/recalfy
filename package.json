{
  "name": "recalfy",
  "version": "0.1.0",
  "description": "Recalfy — a personal AI memory assistant that lives in Telegram",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose stop mongo",
    "db:shell": "docker compose exec mongo mongosh recalfy",
    "tunnel": "ngrok http \"127.0.0.1:${PORT:-3117}\"",
    "whoami": "ts-node -T scripts/whoami.ts",
    "webhook:set": "ts-node -T scripts/set-webhook.ts set",
    "webhook:info": "ts-node -T scripts/set-webhook.ts info",
    "webhook:delete": "ts-node -T scripts/set-webhook.ts delete",
    "chat": "ts-node -T scripts/chat.ts",
    "eval": "ts-node -T scripts/eval.ts",
    "inspect": "ts-node -T scripts/inspect.ts",
    "seed": "ts-node -T scripts/seed.ts",
    "seed:paddle": "ts-node -T scripts/seed-paddle-catalog.ts",
    "migrate:channels": "ts-node -T scripts/migrate-channels.ts",
    "test": "node --no-experimental-strip-types --require ts-node/register --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "paddle:inspect": "ts-node -T scripts/paddle-inspect.ts",
    "paddle:token": "ts-node -T scripts/paddle-client-token.ts",
    "paddle:destination": "ts-node -T scripts/paddle-destination.ts",
    "paddle:simulate": "ts-node -T scripts/paddle-simulate.ts",
    "paddle:mirror": "ts-node -T scripts/paddle-mirror.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "grammy": "^1.30.0",
    "luxon": "^3.5.0",
    "mongodb": "^6.10.0",
    "openai": "^7.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
